{
  "name": "The Whiteboard",
  "version": "1.0",
  "canvas": {"width": 1200, "height": 1500, "square_height": 1200, "margin": 84},
  "colour": {
    "paper": "#FBFAF6",
    "ink": "#1E1E1E",
    "matters": "#2A62DE",
    "risk": "#D3382C",
    "aside": "#8A8A82"
  },
  "font": {
    "display": {"family": "Caveat", "files": {"500": "fonts/caveat-500.ttf", "600": "fonts/caveat-600.ttf", "700": "fonts/caveat-700.ttf"}},
    "hand": {"family": "Kalam", "files": {"300": "fonts/kalam-300.ttf", "400": "fonts/kalam-400.ttf", "700": "fonts/kalam-700.ttf"}},
    "fallback": "'Chalkboard SE', 'Marker Felt', sans-serif"
  },
  "size": {
    "title": 64, "subtitle": 28, "label": 40, "line": 26, "aside": 24, "arrow_label": 24,
    "takeaway": 38, "signature": 24, "number": 300, "unit": 52, "how": 30,
    "step": 38, "step_line": 24, "compare_head": 40, "compare_item": 30, "person_label": 34, "risk_head": 26, "risk_body": 30
  },
  "stroke": {"box": 3.5, "arrow": 3.5, "underline": 4, "figure": 3.5, "risk": 3, "wobble": 1.6, "bow": 4, "corner_radius": 10, "dash": "8 10"},
  "layout": {"box_width_with_margin_column": 520, "box_width_full": 760, "box_height": 120, "takeaway_height": 110, "title_y": 150, "subtitle_y": 215, "flow_top": 330, "takeaway_bottom": 120},
  "limits": {
    "title": 48, "subtitle": 60, "label": 22, "line": 44, "aside": 40, "arrow_label": 34, "takeaway": 80,
    "number_value": 4, "unit": 30, "how": 100, "step": 32, "step_line": 40, "compare_head": 26, "compare_item": 34, "person_label": 22, "risk_head": 22, "risk_body": 24,
    "boxes_min": 2, "boxes_max": 4, "steps_min": 3, "steps_max": 5, "compare_items_max": 5
  },
  "grammar": {
    "title_underline": "always, in matters blue, hand-wobbled, under the title only",
    "matters": "exactly one element carries the matters colour (one box, one step, one column, or the number)",
    "risk": "at most one red element, drawn as a dotted arrow to a thought bubble, never as a filled shape",
    "aside": "grey, in round brackets, small, at most two per picture",
    "person": "a stick figure wherever the picture has a person in it (boxes, ladder, compare), optional for number",
    "takeaway": "one boxed sentence at the bottom, lowercase, no full stop needed, no moral",
    "signature": "the spec's signature (or signature_default), hand, aside colour, bottom right",
    "signature_default": "Your Name",
    "capital_ok": ["I", "AI", "API", "CI", "SQL"],
    "case": "titles and labels lowercase like a whiteboard, proper nouns keep capitals",
    "banned_in_text": ["—", ";", "#", "http", "!!", "✨"]
  }
}
